# ==============================================================================
# Universal WIF Configuration Template (.env.example)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authority Server Settings (universal-wif-server)
# ------------------------------------------------------------------------------
WIF_ISSUER_URL=replace_issuer_url
PORT=8080
WIF_KEY_ID=wif-root-key-1
AGENT_SHARED_SECRET=super-secret-passphrase
JWKS_FETCH_TIMEOUT_SECONDS=5
WIF_TOKEN_EXPIRY_MINUTES=15
WIF_RSA_KEY_BITS=2048
WIF_PRIVATE_KEY_PATH=
WIF_PRIVATE_KEY_PEM=

# ------------------------------------------------------------------------------
# 2. Upstream Identity Providers & Attestation
# ------------------------------------------------------------------------------
SPIRE_JWKS_URL=http://127.0.0.1:8083/keys
SPIRE_EXPECTED_AUDIENCE=universal-wif-authority
SPIRE_AUDIENCE=universal-wif-authority
SPIFFE_ENDPOINT_SOCKET=unix:///tmp/spire-agent/public/api.sock
SPIRE_TIMEOUT_SECONDS=3

JENKINS_JWKS_URL=http://127.0.0.1:8081/oidc/jwks
JENKINS_EXPECTED_AUDIENCE=universal-wif-authority

KUBERNETES_API_URL=replace_kubernetes_url
K8S_SERVER_REVIEWER_TOKEN=
K8S_TLS_INSECURE_SKIP_VERIFY=true
K8S_CLIENT_TIMEOUT_SECONDS=5
K8S_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
K8S_NAMESPACE_PATH=/var/run/secrets/kubernetes.io/serviceaccount/namespace
K8S_NAMESPACE=default

OVERRIDE_MACHINE_ID=

# ------------------------------------------------------------------------------
# 3. Client Helper Settings (universal-wif CLI)
# ------------------------------------------------------------------------------
WIF_SERVER_URL=http://127.0.0.1:8080
WIF_CLIENT_TIMEOUT_SECONDS=10
WIF_AUDIENCE=//iam.googleapis.com/projects/YOUR_PROJECT_NUMBER/locations/global/workloadIdentityPools/universal-pool/providers/universal-jwt-provider

# ------------------------------------------------------------------------------
# 4. Credential Config Generator Defaults (universal-wif init)
# ------------------------------------------------------------------------------
PROJECT_NUMBER=YOUR_PROJECT_NUMBER
PROJECT_ID=YOUR_PROJECT_ID
POOL_ID=universal-pool
PROVIDER_ID=universal-jwt-provider
GSA_EMAIL=wif-sa@YOUR_PROJECT_ID.iam.gserviceaccount.com

WIF_PROJECT_NUMBER=YOUR_PROJECT_NUMBER
WIF_POOL_ID=universal-pool
WIF_PROVIDER_ID=universal-jwt-provider
WIF_SERVICE_ACCOUNT_EMAIL=wif-sa@YOUR_PROJECT_ID.iam.gserviceaccount.com
WIF_BINARY_PATH=/opt/bin/universal-wif
WIF_CONFIG_OUTPUT_PATH=/etc/google/credentials.json
WIF_EXEC_TIMEOUT_MILLIS=10000

# ------------------------------------------------------------------------------
# 5. GCP Endpoints & JWKS Metadata
# ------------------------------------------------------------------------------
GCP_STS_TOKEN_URL=https://sts.googleapis.com/v1/token
GCP_IAM_DOMAIN=iam.googleapis.com
GCP_IAM_CREDENTIALS_ENDPOINT=https://iamcredentials.googleapis.com
WIF_JWKS_ALG=RS256
WIF_JWKS_USE=sig
WIF_JWKS_KTY=RSA